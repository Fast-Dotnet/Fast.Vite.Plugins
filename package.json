{
	"name": "fast-vite-plugins",
	"version": "2.0.17",
	"description": "Production-grade, typed and composable Vite plugins for modern Web applications.",
	"type": "module",
	"keywords": [
		"fast",
		"fast-china",
		"vite",
		"vite-plugin"
	],
	"license": "Apache-2.0",
	"homepage": "http://fastdotnet.com",
	"bugs": {
		"url": "https://gitee.com/FastDotnet/fast.vite.plugins/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://gitee.com/FastDotnet/fast.vite.plugins.git"
	},
	"author": "小方",
	"files": [
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"Fast.png",
		"LICENSE",
		"README.md",
		"README.zh.md",
		"SECURITY.md",
		"dist"
	],
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm run build && pnpm run test:types && pnpm run test:runtime && pnpm run test:integration && pnpm run test:package",
		"test:types": "tsc --noEmit --project tests/tsconfig.json",
		"test:runtime": "node --test tests/cdn.test.mjs tests/generators.test.mjs tests/platform-plugins.test.mjs tests/static-copy.test.mjs tests/utilities.test.mjs tests/shared-plugin.test.mjs tests/tool-ignores.test.mjs",
		"test:integration": "node --test tests/vite-integration.test.mjs",
		"test:package": "node --test tests/package.test.mjs",
		"check": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check",
		"prepack": "pnpm run check"
	},
	"peerDependencies": {
		"vite": "^7.0.0 || ^8.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^24.13.4",
		"eslint": "^10.10.0",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-regexp": "^3.3.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"engines": {
		"node": "^22.18.0 || ^24.18.0",
		"pnpm": "^11.0.0"
	}
}
